     xmlns:xml2tex="http://transpect.io/xml2tex" 
     xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tr="http://transpect.io" decompose-diacritics="no">
  
  <import href="../../xml2tex/latex.conf.xml"/>
 
