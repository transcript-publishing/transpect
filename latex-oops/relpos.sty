\ProvidesPackage{relpos}[2025/11/01 v0.1 beta Insert graphics relative to current position]
\RequirePackage{ifluatex,luatexbase,graphicx,xcolor}

\ifluatex
    \directlua{require ( "relpos.lua" )}

    \ExplSyntaxOn
    \dim_new:N \l__invisibleimage_x_dim
    \dim_new:N \l__invisibleimage_y_dim
    \seq_new:N \l__invisibleimage_coords_seq

    \NewDocumentCommand{\relpos}{ O{} O{0pt,0pt} m }{

        \seq_set_split:Nnn \l__invisibleimage_coords_seq { , } { #2 }
        \dim_set:Nn \l__invisibleimage_x_dim { \seq_item:Nn \l__invisibleimage_coords_seq { 1 } }
        \dim_set:Nn \l__invisibleimage_y_dim { \seq_item:Nn \l__invisibleimage_coords_seq { 2 } }

        \ExplSyntaxOff

        \sbox0{%
            \kern \l__invisibleimage_x_dim
            \raise \l__invisibleimage_y_dim
            \hbox{\includegraphics[#1]{#3}}
        }%
        \directlua{process_and_write_invisible_box0()}%
    }
    \ExplSyntaxOff

    \NewDocumentCommand{\relpospar}{ O{} O{0pt,0pt} m }{%
        \ifvmode\leavevmode\fi%
        \relpos[#1][#2]{#3}%
        \vspace{\dimexpr -\baselineskip - \parskip\relax}\par
        \nopagebreak[4]
    }
\else
    \errhelp{Compile with LuaLaTeX to be able to use the "check-hyph-words" package.}
    \errmessage{Package "check-hyph-words" error: This package requires LuaLaTeX!}
\fi
