\DeclareRobustCommand\raggedrightKeepIndent{%
  \let\\\@centercr
  \@rightskip\@flushglue
  \rightskip\@rightskip
  \parindent\z@
}


\def\tp@partmark{\tpRunBookTitle}%

% Dieses Makro \texthashchar soll insbesondere in \tpBMTitle{…} Verwendung finden, weil
%   eine Raute (#) einen Kompilationsfehler verursacht und \# gar nicht dargestellt wird.
\begingroup
  \catcode `\#=\active\gdef#{\string#}
  \gdef\texthashchar{\string#}%
\endgroup


\tpDeclareHeading{-1}{part}{%
  %%%%%%%%%%%%%%%%%%%%%%%
  % Inhaltsverzeichnis. %
  %%%%%%%%%%%%%%%%%%%%%%%  
  \tpSetProperty{toc-margin-top}{2.25em}%
  \tpSetProperty{toc-indent}{}%
  \tpSetProperty{toc-title-face}{%
    \sffamily\sbseries
    \ifx\ts@layout@type\ts@str@layout@mdw
      \LARGE
    \else
      \huge
    \fi
    \raggedrightKeepIndent
  }%
  
  \tpSetProperty{toc-before-entry}{%
    \addvspace{\tpUseProperty{toc-margin-top}}
    \parindent \z@
    \hyphenpenalty=\@M
    \let\\\@centercr
    \rightskip\z@skip\relax
    \parfillskip\@flushglue
  }%
  
  \tpSetProperty{toc-format}{%
    \ccaVstructStart{TOCI}%
    \tpIfComp{TocNumber}{%
      \ccaVstructStart{P}\ccaVstructStart{Reference}%
      \ifcsname cc-Heading-toc-number--1-maxwd\endcsname
        \@tempdima=\csname cc-Heading-toc-number--1-maxwd\endcsname%
      \else
        \@tempdima=\z@%
      \fi%
      \leftskip\@tempdima%
    }{%
      \leftskip\z@%
    }%
    \tpUseProperty{toc-title-face}%
    \tpTocLink{%
      \ccWhenComp{TocNumber}{%
        \hskip-\@tempdima\hbox to \@tempdima{%
          \ccaVstructStart{Lbl}%
          \tpUseComp{TocNumber}%
          \tpUseProperty{toc-number-sep}%
          \ccaVstructEnd{Lbl}%
          \hss
        }%
      }%
      \ccaVstructStart{Span}\tpUseComp{TocTitle}\ccaVstructEnd{Span}%
    }%
    \ccWhenComp{TocNumber}{\ccaVstructEnd{Reference}\ccaVstructEnd{P}}%
    \ccaVstructEnd{TOCI}%
    \par
  }%

  %%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Fließtextüberschriften. %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%
  \tpSetProperty{margin-left}{}%
  \tpSetProperty{indent}{}%
  
  \tpSetProperty{title-face}{%
    \sffamily\sbseries
    \ifx\ts@layout@type\ts@str@layout@mdw
      \Huge
    \else
      \HUGE
    \fi
    \ifx\ts@layout@type\ts@str@layout@utb
      \fontsize{26bp}{27bp}\selectfont
      \bfseries
      \sfchapfamily
    \fi
  }%
  
  \tpSetProperty{quote-block-format}{%
    \minusvspace{0.5\baselineskip}%
    \rightskip\z@
    \normalfont\normalsize%
    \ifx\ts@layout@type\ts@str@layout@mdw
      \rmfamily%
    \else
      \nsfwiderfamily%
    \fi
    \@tempdima=\baselineskip% Ticket 15122.
    \baselineskip=\dimexpr0.92\@tempdima\relax% Ticket 15122.
    \tpUseComp{QuoteText}\par
    % Zitatquelle.
    \tpIfComp{QuoteSource}{%
      {\itshape\tpUseComp{QuoteSource}\par}%
    }{}%
  }%
  
  \tpSetProperty{before-heading}{%
    \cleardoublepage
    \null\vskip\headingsep
    \thispagestyle{empty}%
    %\global\let\@chaptermark\@undefined
    \global\let\has@parts\relax
    \immediate\write\@auxout{\string\global\string\let\string\has@parts\string\relax}%
    % Zurücksetzen der Fußnotenzählen bereits bei Parts, nicht erst bei Chapter. Ticket 15665.
    \global\c@footnote\z@
    \tpIfComp{Number}{%
      \tpGStoreComp\tp@partnumber{Number}%
    }{%
      \global\let\tp@partnumber\relax
    }%
  }%

  \tpSetProperty{running-heading}{%
    \ifx\tp@partnumber\relax
    \else
      \tp@partnumber\space
    \fi
    \tp@partmark%
  }%

  \tpSetProperty{heading-block}{%
    \gdef\tp@currentHeading{chapter}%
    % Kolumnentitel setzen.
    \ifcollection
      \ifjournal
        \tpIfComp{RunTitle}{%
          \tpGStoreComp\tp@partmark{RunTitle}%
        }{%
          \tpIfComp{Title}{%
            \tpGStoreComp\tp@partmark{Title}%
          }{}%
        }
      \else
        \global\let\tp@authormark\relax%
        %\global\let\tp@partmark\undefined% Nutzt dann den Buchtitel als Fallback.
        \tpIfComp{RunTitle}{%
          \tpGStoreComp\tp@chaptermark{RunTitle}%
          \tpGStoreComp\tp@latestPartmark{RunTitle}%
        }{%
          \tpGStoreComp\tp@chaptermark{Title}%
          \tpGStoreComp\tp@latestPartmark{Title}%
        }%
      \fi
    \else
      \tpIfComp{RunTitle}{%
        \tpGStoreComp\tp@chaptermark{RunTitle}%
      }{
        \tpGStoreComp\tp@chaptermark{Title}%
      }%
      \tpIfComp{RunNumber}{%
        \tpGStoreComp\tp@chapternumber{RunNumber}%
      }{
        \tpIfComp{Number}{%
          \tpGStoreComp\tp@chapternumber{Number}%
        }{%
          \global\let\tp@chapternumber\relax%
        }%
      }%
    \fi
    \tpUseProperty{title-face}%
    %\vskip.5\baselineskip
    \cchHeadTagStart
      \ccIfComp{Number}{%
        \ifcsname cc-Heading-number--1-maxwd\endcsname
          \@tempdima=\dimexpr\csname cc-Heading-number--1-maxwd\endcsname+0.5em\relax
        \else
          \@tempdima=\z@
        \fi
        \ccaVstructStart{Lbl}%
          \leftskip\@tempdima
          \hskip-\@tempdima
          \ifx\ts@layout@type\ts@str@layout@utb
            \textcolor{UTBHeading}{%
          \fi
          \hb@xt@\@tempdima{\tpUseComp{Number}\hss}%
          \ifx\ts@layout@type\ts@str@layout@utb
            }%
          \fi
        \ccaVstructEnd{Lbl}%
      }{}%
      \ignorespaces
      \ifx\ts@layout@type\ts@str@layout@utb
        \textcolor{UTBHeading}{%
      \fi
      \tpUseComp{Title}%
      \ifx\ts@layout@type\ts@str@layout@utb
        }%
      \fi
      \par
      \cchGenerateToC% Erzeugt die Verzeichniseinträge (auch PDF-Lesezeichen). Ticket 18344.
    \cchHeadTagEnd
    \tpIfComp{Subtitle}{%
      \@@par
      \vskip\baselineskip
      \large\bfseries
      \tpUseComp{Subtitle}%
      \leavevmode
      \vskip\baselineskip
    }{}%
    %% Zitat
    \tpIfComp{QuoteBlock}{%
      \vskip1.5\baselineskip
      \savenotes
      \hfill
      \begin{minipage}[t]{0.5\textwidth}%
        \tpUseComp{QuoteBlock}%
      \end{minipage}%
      \spewnotes
      \vskip\baselineskip% Ticket 15665.
    }{}%
  }
  
  \tpSetProperty{after-heading-block}{%
    % Alles auskommentiert für Ticket 19317.
    %\vfill
    %\ifcollection
    %  \ifjournal
    %  \else
    %    \cleardoublepage
    %  \fi
    %\fi
  }
  
  \tpSetProperty{after-skip}{3\baselineskip}
}


