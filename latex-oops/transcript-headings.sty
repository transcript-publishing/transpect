  \tpSetProperty{toc-number-sep}{\enskip}
  \ifcollection
  \else
    \tpSetProperty{toc-indent}{2em}%
    \tpSetProperty{toc-margin-left}{4em}%
    \tpSetProperty{toc-margin-right}{0\p@}%
  \fi
  \ifcollection
    \tpSetProperty{toc-format}{%
      \ccaVstructStart{TOCI}%
      \ccWhenComp{TocNumber}{\ccaVstructStart{P}\ccaVstructStart{Reference}}%
      \tpUseProperty{toc-title-face}%
      \@tempdima=\csname cc-Heading-toc-number-2-maxwd\endcsname\relax%
      \@tempdimb=\csname cc-Heading-toc-number-1-maxwd\endcsname\relax%
      \@tempdimc=\csname cc-Heading-toc-number-0-maxwd\endcsname\relax%
      \ifdim\@tempdimb<\@tempdimc\relax
        \@tempdimb=\@tempdimc\relax%
      \fi%
      \tpIfComp{TocNumber}{%
        \tpIfComp{TocAuthorNameList}{\tpTocLink{\ccaVstructStart{Span}\tpUseComp{TocAuthorNameList}:\ccaVstructEnd{Span}}\newline}{}%
        \leftskip\dimexpr\@tempdima+\@tempdimb\relax
        \hskip-\@tempdima\hbox to \@tempdima{\tpTocLink{\ccaVstructStart{Lbl}\tpUseComp{TocNumber}\ccaVstructEnd{Lbl}}\hss}%
      }{%
        \leftskip\@tempdimb%
        \tpIfComp{TocAuthorNameList}{\tpTocLink{\ccaVstructStart{Span}\tpUseComp{TocAuthorNameList}:\ccaVstructEnd{Span}}\space}{}%
      }%
      \noindent%
      % \advance\leftskip by 4em%
      \setbox\@tempboxa=\hbox{\tpUseComp{TocPage}}%
      \rightskip\wd\@tempboxa plus 1fil% 1fil sorgt für Linksbündigkeit des IHV-Eintrags.
      \tpTocLink{%
        \ccaVstructStart{Span}\tpUseComp{TocTitle}\ccaVstructEnd{Span}%
        \tpIfComp{TocSubtitle}{\newline{\tpUseProperty{toc-subtitle-face}\ccaVstructStart{Span}\tpUseComp{TocSubtitle}\ccaVstructEnd{Span}}}{}%
        \ccaVstructStart[Document]{leaders}\tpUseProperty{toc-page-sep}\ccaVstructEnd{leaders}%
        \ccaVstructStart{Span}\rlap{\hb@xt@\wd\@tempboxa{\hss\tpUseComp{TocPage}}}\ccaVstructEnd{Span}%
      }%
      \ccWhenComp{TocNumber}{\ccaVstructEnd{Reference}\ccaVstructEnd{P}}%
      \ccaVstructEnd{TOCI}%
      \par
    }%
  \else
    \tpSetProperty{toc-before-entry}{%
      \addvspace{\tpUseProperty{toc-margin-top}}
      \parindent \z@
      \raggedright
    }%
    \tpSetProperty{toc-format}{%
      \ccaVstructStart{TOCI}%
      \ccWhenComp{TocNumber}{\ccaVstructStart{P}\ccaVstructStart{Reference}}%
      \tpUseProperty{toc-title-face}%
      \@tempdima=\csname cc-Heading-toc-number-1-maxwd\endcsname\relax%
      \@tempdimb=\csname cc-Heading-toc-number-2-maxwd\endcsname\relax%
      \tpIfComp{TocNumber}{%
        \leftskip\dimexpr\@tempdima+\@tempdimb\relax\hskip-\@tempdimb\hb@xt@\@tempdimb{\tpTocLink{\ccaVstructStart{Lbl}\tpUseComp{TocNumber}\ccaVstructEnd{Lbl}\tpUseProperty{toc-number-sep}}\hss}%
      }{%
        \ifdim\@tempdima=0\p@
          \leftskip1em% Ticket 16195.
        \else
          \leftskip\@tempdima%
        \fi
      }%
      \setbox\@tempboxa=\hbox{\tpUseComp{TocPage}}%
      \advance\rightskip\wd\@tempboxa%
      \tpTocLink{%
        \ccaVstructStart{Span}\tpUseComp{TocTitle}\ccaVstructEnd{Span}%
        \tpWhenComp{TocSubtitle}{%
          \newline%
          {\tpUseProperty{toc-subtitle-face}\ccaVstructStart{Span}\tpUseComp{TocSubtitle}\ccaVstructEnd{Span}}%
        }%
        \ccaVstructStart[Document]{leaders}\tpUseProperty{toc-page-sep}\ccaVstructEnd{leaders}%
        \ccaVstructStart{Span}\rlap{\unhbox\@tempboxa}\ccaVstructEnd{Span}%
      }%
      \ccWhenComp{TocNumber}{\ccaVstructEnd{Reference}\ccaVstructEnd{P}}%
      \ccaVstructEnd{TOCI}%
      \par
    }%
  \fi
}


\tpDeclareHeading[section]{3}{subsubsection}{%
