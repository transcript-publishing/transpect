\tpDeclareHeading{0}{chapter}{%
  % Ticket 13717.
  \if@backmatter%
    \tpSetProperty{bookmark-level}{-1}%
  \fi
  %% Format IHV-Eintrag
  \tpSetProperty{toc-margin-top}{1\baselineskip}%
  \tpSetProperty{toc-margin-right}{2em}% Begrenzt die Breite, auf der Titel und Untertitel erscheinen können. 2 em sind dann der Platz, auf dem die Seitenzahl »übersteht«.
  \tpSetProperty{toc-number-sep}{\enskip}%
  \tpSetProperty{toc-title-face}{%
    \let\@withinTocTitle\relax
    \def\@sffallbackfeatures{%
      \addfontfeature{FakeBold=3.2}%
      \sffallbackfontcondensed
      \edef\@tempa{it}%
      \ifx\f@shape\@tempa
        \addfontfeature{FakeSlant=-0.09}%
      \fi
    }%
    \sbseries\sfchapwidefamily\normalsize
  }%
  \tpSetProperty{toc-subtitle-face}{\let\@withinTocTitle\relax\normalfont\sfchapsubtocfamily\normalsize\if@TLtwenty\upseries\fi}%
  \tpSetProperty{toc-author-face}{\let\@withinTocAuthor\relax\normalfont\normalsize\sfchapfamily\itshape\if@TLtwenty\upseries\fi}%
  \tpSetProperty{toc-page-face}{\normalfont\normalsize\sfchapwidefamily\if@TLtwenty\upseries\fi}%
  \tpSetProperty{toc-indent}{0em}%
  \tpSetProperty{toc-margin-left}{0em}%
  \tpSetProperty{toc-format}{%
    \hyphenpenalty=\@M
    %\ifdim\dimexpr\pagegoal-\pagetotal\relax<7\baselineskip\relax
    %  \clearpage%
    %\fi
    % VBox verhindert durch Seitenumbruch auseinandergerissene Überschriften im Inhaltsverzeichnis.
    \ccaVstructStart{TOCI}%
    \ccWhenComp{TocNumber}{\ccaVstructStart{P}\ccaVstructStart{Reference}}%
    \vtop{\strut%
      \tpUseProperty{toc-title-face}%
      \tpIfComp{TocNumber}{%
        \@tempdima=\csname cc-Heading-toc-number-0-maxwd\endcsname%
        \@tempdimb=0\p@\relax
        \expandafter\ifx\csname cc-Heading-toc-number-1-maxwd\endcsname\relax%
        \else%
          \@tempdimb=\csname cc-Heading-toc-number-1-maxwd\endcsname\relax%
        \fi%
        \ifdim\@tempdima<\@tempdimb\relax%
          \@tempdima=\@tempdimb%
        \fi%
        \leftskip\@tempdima%
      }{%
        \leftskip\z@%
      }%
      %\ccaAddAltText{Test}% Test für Ticket 19448.
      \tpTocLink{%
        \ccWhenComp{TocNumber}{\hskip-\@tempdima\hbox to \@tempdima{%
            \ccaVstructStart{Lbl}\tpUseComp{TocNumber}\ccaVstructEnd{Lbl}\hss}}%
        \strut\ccaVstructStart{Span}\tpUseComp{TocTitle}\ccaVstructEnd{Span}%
        \tpWhenComp{TocSubtitle}{%
          \nopagebreak
          \newline
          {%
            \tpUseProperty{toc-subtitle-face}%
            \ccaVstructStart{Span}\tpUseComp{TocSubtitle}\ccaVstructEnd{Span}%
          }%
        }%
        \tpIfComp{TocAuthorNameList}{%
          \long\def\@tempa{\ignorespaces}%
          \ifx\@tempa\tp@heading@TocAuthorNameList
          \else
            \nopagebreak\newline
            {%
              \tpUseProperty{toc-author-face}\ccaVstructStart{Span}\tpUseComp{TocAuthorNameList}\ccaVstructEnd{Span}%
            }%
          \fi
        }{}%
        \tpUseProperty{toc-page-face}%
        \ccaVstructStart[Document]{leaders}\tpUseProperty{toc-page-sep}\ccaVstructEnd{leaders}%
        \ccaVstructStart{Span}\tpUseComp{TocPage}\ccaVstructEnd{Span}%
        \strut%
      }%
    }%
    \ccWhenComp{TocNumber}{\ccaVstructEnd{Reference}\ccaVstructEnd{P}}%
    \ccaVstructEnd{TOCI}%
  }%
  % Unter Umständen nur für Monographien sinnvoll. In jenem Fall dann entsprechend anpassen.
  \tpSetProperty{toc-after-entry}{%
    \ifcollection
    \else
      \ifnum\c@tocdepth>0
        \nopagebreak%
      \fi%
    \fi%
  }%
  %% Format PDF-Bookmarks
  \tpSetProperty{bookmark}{%
    % \tpIfComp{TocAuthor}{\tpUseComp{TocAuthor}:\space}{}%
    \tpIfComp{BMNumber}{%
      \tpUseComp{BMNumber}\space%
    }{}%
    \tpUseComp{BMTitle}%
  }%
  
  \tpSetProperty{title-face}{%
    \let\@withinHeadingTitle\relax
    \def\@sffallbackfeatures{%
      \addfontfeature{FakeBold=3.2}%
      \edef\@tempa{it}%
      \ifx\f@shape\@tempa
        \addfontfeature{FakeSlant=-0.09}%
      \fi
    }%
    \ifx\ts@layout@type\ts@str@layout@mdw
      \huge
    \else
      \Huge
    \fi
    \sbseries\sfchapfamily
    % UTB-Layout.
    \ifx\ts@layout@type\ts@str@layout@utb
      \fontsize{22bp}{23bp}\selectfont
      \bfseries
      \sfchapfamily
    \fi
  }%
  
  \tpSetProperty{subtitle-face}{\normalfont\fontsize{13.7bp}{17.2bp}\selectfont\sfchapsubfamily\upseries}
  \tpSetProperty{quote-block-format}{%
    \parskip\baselineskip
    \rightskip\z@
    % BEGIN: Modifiziertes \RaggedRight (\raggedright mit Silbentrennung).
    \leftskip0.5\textwidth
    \@rightskip\RaggedRightRightskip
    \rightskip\@rightskip
    % END.
    \normalfont
    \normalsize
    \ifx\ts@layout@type\ts@str@layout@mdw
      \rmfamily%
    \else
      \nsfwiderfamily%
    \fi
    \@tempdima=\baselineskip% Ticket 15122.
    \baselineskip=\dimexpr0.92\@tempdima\relax% Ticket 15122.
    \tpUseComp{QuoteText}%
    \tpIfComp{QuoteSource}{%
      {\hfill\break\itshape\tpUseComp{QuoteSource}}\par%
    }{%
      \par%
    }%
  }%
  \tpSetProperty{before-heading}{%
    \ifx\@noBlanksBeforeChapters\relax
      \clearpage
    \else
      \cleardoublepage
    \fi
    \if@twocolumn\else
      \null\nobreak
      \vskip\dimexpr\headingsep-.45mm\relax
    \fi%
    \directlua{Oe_resetcounter ()}%
  }%
  
  \tpSetProperty{running-heading}{%
    \tp@chaptermark%
  }%
  
  \tpSetProperty{heading-block}{%
    \gdef\tp@currentHeading{chapter}%
    \ifx\ts@layout@type\ts@str@layout@utb
      \bgroup
        \tpIfComp{RunNumber}{%
          \tpGStoreComp\tp@chapternumber{RunNumber}%
        }{%
          \tpIfComp{Number}{%
            \tpGStoreComp\tp@chapternumber{Number}%
          }{%
            \global\let\tp@chapternumber\relax
          }%
        }%
        \tpIfComp{RunTitle}{%
          \tpGStoreComp\tp@chaptermark{RunTitle}%
        }{%
          \tpGStoreComp\tp@chaptermark{Title}%
        }%
        \tpIfComp{RunAuthorNameList}{%
          \xdef\tp@authormark{\cc@Heading@RunAuthorNameList}%
        }{%
          \tpIfCompOverride{AuthorNameList}{%
            \ifx\ts@layout@type\ts@str@layout@utb
              \tpGStoreComp\tp@authormark{AuthorNameList}%
            \else
              \xdef\tp@authormark{\noexpand\cc@Heading@AuthorNameList}%
            \fi
          }{%
            \gdef\tp@authormark{\unhcopy\@bookAuthorBox}%
          }%
        }%
        \thispagestyle{empty}%
        \tpUseProperty{title-face}%
        \tpWhenComp{Number}{\leftskip-\tpUseProperty{indent}}%
        \bgroup%
          \cchHeadTagStart
            \tpIfComp{Number}{%
              \ccaVstructStart{Lbl}%
                \rightskip0.15\textwidth plus 1fil
                \leftskip10mm
                \hskip-10mm
                \textcolor{UTBHeading}{\hb@xt@10mm{\tpUseProperty{Number}\hss}}%
              \ccaVstructEnd{Lbl}%
            }{%
              \leftskip\z@
            }%
            \ignorespaces\textcolor{UTBHeading}{\tpUseComp{Title}}\par
            \cchGenerateToC% Erzeugt die Verzeichniseinträge (auch PDF-Lesezeichen). Ticket 18344.
          \cchHeadTagEnd
        \egroup
        \tpWhenComp{Subtitle}{%
          \par\vskip1.1bp%
          \tpUseProperty{subtitle-face}%
          \ccaVstructStart{P}%
          \tpUseComp{Subtitle}%
          \ccaVstructEnd{P}%
        }%
        \par
        \tpIfComp{AuthorNameList}{%
          {%
            \tpIfComp{Number}{%
              \leftskip10mm
            }{%
              \leftskip\z@
            }%
            \normalfont
            \sfchapfamily
            \itshape
            \large
            \vskip0.5\baselineskip
            \textcolor{UTBHeading}{\tpUseComp{AuthorNameList}}\par
            \vskip2\baselineskip
          }
        }{}%
      \egroup\nobreak
    \else
      \ifcollection
        \ifx\tp@latestPartmark\relax\else
          \protected@xdef\tp@partmark{\tp@latestPartmark}%
        \fi
      \fi
      \tpIfComp{RunNumber}{%
        \tpGStoreComp\tp@chapternumber{RunNumber}%
      }{%
        \tpIfComp{Number}{%
          \tpGStoreComp\tp@chapternumber{Number}%
        }{%
          \global\let\tp@chapternumber\relax
        }%
      }%
      \tpIfComp{RunTitle}{%
        \tpGStoreComp\tp@chaptermark{RunTitle}%
      }{%
        \tpGStoreComp\tp@chaptermark{Title}%
      }%
      \tpIfComp{RunAuthorNameList}{%
        \tpGStoreComp\tp@authormark{RunAuthorNameList}%
      }{%
        \tpIfCompOverride{AuthorNameList}{%
          \tpGStoreComp\tp@authormark{AuthorNameList}%
          %\xdef\tp@authormark{\protect\cc@Heading@AuthorNameList}% Auskommentiert für Ticket 19515.
        }{%
          \tpCompGDef\tp@authormark{Author}{author-list-print-format}%
        }%
      }%
      \ifx\ts@journal@series\ts@str@journal@zig
        \protected@xdef\tp@partmark{\tp@authormark}%
      \fi
      %% Titel
      \ifjournal\else
        \ifx\@twocolumnContinuousChapters\relax
          \thispagestyle{headings}%
        \else
          \thispagestyle{empty}%
        \fi
      \fi
      \leftskip\z@
      \leavevmode
      \bgroup
        \raggedright
        \tpWhenComp{Number}{\leftskip-\tpUseProperty{indent}}%
        \tpUseProperty{title-face}%
        \bgroup%
          \cchHeadTagStart
            \tpWhenComp{Number}{\ccaVstructStart{Lbl}\tpUseProperty{hang-number}\ccaVstructEnd{Lbl}}%
            \ignorespaces\tpUseComp{Title}\par%
            \cchGenerateToC% Erzeugt die Verzeichniseinträge (auch PDF-Lesezeichen). Ticket 18344.
          \cchHeadTagEnd
        \egroup
        \tpWhenComp{Subtitle}{%
          \par\vskip1.1bp%
          \tpUseProperty{subtitle-face}%
          \ccaVstructStart{P}%
          \tpUseComp{Subtitle}%
          \ccaVstructEnd{P}%
        }%
        \par
      \egroup\nobreak
      %% Linie
      \vskip\dimexpr-1\baselineskip\relax
      \ccaVstructStart{Div}%
      \ccaVstructStart[Document]{Rule}%
      \smash{\rlap{\lower3.25mm\vbox{\rule{\hsize}{.4\p@}}}}\par\nobreak
      \ccaVstructEnd{Rule}%
      %% Autor
      \tpWhenComp{AuthorNameList}{%
        \vskip\baselineskip
        \ccaVstructStart{Authors}%
          {%
            \tpUseProperty{author-face}%
            \large\sfwidefamily\upseries\itshape
            \tpUseComp{AuthorNameList}%
          }%
        \ccaVstructEnd{Authors}%
        \ifx\ts@contact@dummy\@undefined
        \else
