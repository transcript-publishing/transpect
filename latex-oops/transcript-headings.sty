      \mdseries
    \fi
  }%
  \ifcollection\else
    %\tpSetProperty{toc-indent}{8em}%
    \tpSetProperty{toc-margin-left}{6.5em}%
  \fi
  \tpSetProperty{toc-format}{%
    \ccaVstructStart{TOCI}%
    \ccWhenComp{TocNumber}{\ccaVstructStart{P}\ccaVstructStart{Reference}}%
    \tpIfComp{TocAuthorNameList}{\tpTocLink{\ccaVstructStart{Span}\tpUseComp{TocAuthorNameList}:\ccaVstructEnd{Span}}\newline}{}%
    \tpUseProperty{toc-title-face}%
    \@tempdima=\csname cc-Heading-toc-number-3-maxwd\endcsname\relax%
    \@tempdimb=\csname cc-Heading-toc-number-1-maxwd\endcsname\relax%
    \@tempdimc=\csname cc-Heading-toc-number-0-maxwd\endcsname\relax%
    \ifdim\@tempdimb<\@tempdimc\relax
      \@tempdimb=\@tempdimc\relax%
    \fi%
    \@tempdimc=\csname cc-Heading-toc-number-2-maxwd\endcsname\relax%
    \leftskip\dimexpr\@tempdima+\@tempdimb+\@tempdimc\relax%
    \tpWhenComp{TocNumber}{%
      \hskip-\@tempdima\hbox to \@tempdima{\tpTocLink{\ccaVstructStart{Lbl}\tpUseComp{TocNumber}\ccaVstructEnd{Lbl}}\hss}%
    }%
    \tpTocLink{%
      \ccaVstructStart{Span}\tpUseComp{TocTitle}\ccaVstructEnd{Span}%
      \tpIfComp{TocSubtitle}{\newline{\tpUseProperty{toc-subtitle-face}\ccaVstructStart{Span}\tpUseComp{TocSubtitle}\ccaVstructEnd{Span}}}{}%
      \ccaVstructStart[Document]{leaders}\tpUseProperty{toc-page-sep}\ccaVstructEnd{leaders}%
      \ccaVstructStart{Span}\tpUseComp{TocPage}\ccaVstructEnd{Span}%
    }%
    \ccWhenComp{TocNumber}{\ccaVstructEnd{Reference}\ccaVstructEnd{P}}%
    \ccaVstructEnd{TOCI}%
    \par
  }%
  \tpSetProperty{quote-block-format}{%
    \hfill\vbox{%
      %\justify% Auskommentiert mit Ticket 15122.
