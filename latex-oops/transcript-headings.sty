  %\tpSetProperty{after-skip}{1sp}% Ticket 12534, 2022-04-25
  \tpSetProperty{title-face}{%
    \let\@withinHeadingTitle\relax
    \def\@sffallbackfeatures{%
      %\addfontfeature{FakeBold=0.1}%
