\definecolor{UTBHeading}{RGB}{90, 90, 90}

%% Globale Settings: gelten für alle ÜS-Ebenen
\tpAddToDefault{Heading}{%
  \tpSetProperty{numbering}{}%
  \tpSetProperty{margin-left}{}% leer um Default "auto" zu überschreiben
  \tpSetProperty{indent}{auto}%
  \tpSetProperty{toc-margin-right}{6em}%
  \ifcollection
    \tpSetProperty{toc-margin-left}{}%
    \tpSetProperty{toc-indent}{}%
  \else
    \tpSetProperty{toc-margin-left}{\tpIfComp{TocNumber}{auto}{0mm}}%
    \tpSetProperty{toc-indent}{auto}%
  \fi
  \tpSetProperty{toc-number-align}{left}%
  \tpSetProperty{toc-number-sep}{\enskip}%
  \tpSetProperty{toc-page-sep}{\tsDotfill}% Definition für \tsDotfill in der Hauptdatei transcript.sty.
  \tpSetProperty{toc-title-face}{\let\@withinTocTitle\relax\sffamily\normalsize\if@TLtwenty\upseries\fi}% Mig2024
  \tpSetProperty{toc-page-face}{\normalfont\sfwidefamily\normalsize\if@TLtwenty\upseries\fi}% Mig2024
  \tpSetProperty{toc-format}{%
    \tpUseProperty{toc-title-face}%
    \ccaVstructStart{TOCI}%
    \tpWhenComp{TocNumber}{\ccaVstructStart{P}\ccaVstructStart{Reference}}%
    \tpTocLink{%
      \tpWhenComp{TocAuthorNameList}{\ccaVstructStart{Span}\tpUseComp{TocAuthorNameList}:\ccaVstructEnd{Span}\newline}%
      \tpWhenComp{TocNumber}{\ccaVstructStart{Lbl}\tpUseProperty{toc-hang-number}\ccaVstructEnd{Lbl}}%
      \ccaVstructStart{Span}\tpUseComp{TocTitle}\ccaVstructEnd{Span}%
      \tpWhenComp{TocSubtitle}{%
        \hfill\break%
        \ccaVstructStart{Span}\tpUseComp{TocSubtitle}\ccaVstructEnd{Span}%
      }%
      \ccaVstructStart[Document]{leaders}\tpUseProperty{toc-page-sep}\ccaVstructEnd{leaders}%
      \ccaVstructStart{Span}\tpUseComp{TocPage}\ccaVstructEnd{Span}%
    }%
    \tpWhenComp{TocNumber}{\ccaVstructEnd{Reference}\ccaVstructEnd{P}}%
    \ccaVstructEnd{TOCI}%
    \par
  }%
  \ccSetProperty{author-face}{\let\@withinHeadingAuthor\relax\normalfont}%
  \tpSetProperty{running-heading}{}%
  \tpSetProperty{running-extra}{}%
}

\gdef\tp@currentHeading{}


% Ticket 17717. \nopagebreak funktioniert in den Hooks seit Frameworkumstellung nicht mehr (zuverlässig). Deswegen dieser etwas umständliche Workaround. Wird wahrscheinlich bei manchen Titeln zu unerwünschten vorzeitigen Seitenumbrüchen führen.
\AddToHook{cc/headings/part/toc/before}{%
  \setbox\z@=\vbox{\tpUseProperty{toc-title-face}\tpUseComp{TocTitle}}%
  \@tempdima=\dimexpr\pagegoal-\pagetotal\relax
  \ifdim\dimexpr\@tempdima-\ht\z@\relax>0\p@\relax
    \ifdim\dimexpr\@tempdima-\ht\z@\relax<5\baselineskip
      \newpage
    \fi
  \fi
}

