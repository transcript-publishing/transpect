\newcount\@qrCode


\def\utbQRCode#1#2#3{%
  \par
  %\vskip0.5\baselineskip
  \phantomsection
  \label{qrCode-\the\@qrCode}%
  \getLabelPage{qrCode-\the\@qrCode}%
  \global\advance\@qrCode\@ne
  \ifodd\realpage
    \vbox{%
      \noindent
      \textbf{#1}\newline
      \href{#2}{#2}%
      \hfill
      \smash{%
        \rlap{%
          \raisebox{-1.1\baselineskip}{\includegraphics[height=12mm]{#3}}%
        }%
      }%
    }
  \else
    \vbox{%
      \smash{%
        \llap{%
          \raisebox{-2.1\baselineskip}{\includegraphics[height=12mm]{#3}}%
          \hspace*{5mm}%
        }%
      }%
      \noindent
      \textbf{#1}\newline
      \href{#2}{#2}%
    }
  \fi
  %\vskip\baselineskip
  \addvspace{2\baselineskip}
}

