%% Überdef
\def\@enum@{%
  \list{%
      \csname label\@enumctr\endcsname
  }{%
    \labelsep\z@
    \itemsep\z@
    \ifnum \@enumdepth=\@ne
      \leftmargin\parindent
      \labelwidth\parindent
    \else
      \@tempdima3mm
      \leftmargin\dimexpr\@enumdepth\@tempdima\relax
      \labelwidth\dimexpr\@enumdepth\@tempdima\relax
      \itemindent\z@%\leftmargin
    \fi
    \parsep\z@
    \partopsep\z@
    \ifnum \@enumdepth=\@ne\topsep12.8bp\else\topsep\z@\fi
    \usecounter\@enumctr%
    \global\let\is@first@item\relax
    \ccaVstructStart{L}%
      \def\makelabel##1{%
        \ifx\is@first@item\relax
          \global\let\is@first@item\@undefined
        \else
            \ccaVstructEnd{LBody}%
          \ccaVstructEnd{LI}%
        \fi
        \ccaVstructStart{LI}%
          \ccaVstructStart{Lbl}%
            \small##1\hss
          \ccaVstructEnd{Lbl}%
          \ccaVstructStart{LBody}%
      }%
  }%
}
\let\ltx@endenumerate\endenumerate
\def\endenumerate{\ccaVstructEnd{LBody}\ccaVstructEnd{LI}\ccaVstructEnd{L}\ltx@endenumerate}

\let\leftmarginii\leftmargini
